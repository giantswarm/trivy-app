{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as the `additionalProperties` setting would otherwise collide with Helm's special 'global' values key."
        },
        "kyvernoPolicyExceptions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "namespace": {
                    "type": "string"
                }
            }
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "ingress": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "namespaceSelector": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "podSelector": {
                            "type": "object",
                            "additionalProperties": false
                        }
                    }
                }
            }
        },
        "trivy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "image": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "registry": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        }
                    }
                },
                "rbac": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "pspEnabled": {
                            "type": "boolean"
                        }
                    }
                },
                "securityContext": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivilegeEscalation": {
                            "type": "boolean"
                        },
                        "privileged": {
                            "type": "boolean"
                        },
                        "readOnlyRootFilesystem": {
                            "type": "boolean"
                        }
                    }
                },
                "trivy": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "dbRepository": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "verticalPodAutoscaler": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "trivy": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "containerPolicies": {
                            "type": "object",
                            "additionalProperties": false
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        }
    }
}
